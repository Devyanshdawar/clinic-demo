# Clinic Base URL
NEXT_PUBLIC_APP_URL=https://veritashealthclinic.com

# Email Notifications (Resend or SMTP)
# Provide RESEND_API_KEY or configure standard SMTP credentials
RESEND_API_KEY=re_your_api_key_here
CLINIC_NOTIFICATION_EMAIL=care@veritashealthclinic.com

# SMTP Fallback (Optional)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_password
SMTP_FROM=appointments@veritashealthclinic.com

# Analytics Placeholders (Google Analytics 4 / Meta Pixel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

